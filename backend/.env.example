# ===========================================================================
#  BookLeaf Author Support Portal - backend configuration
#  Copy to `.env` (never commit `.env`) and adjust as needed:
#      cp .env.example .env
# ===========================================================================

# --- application -----------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
APP_VERSION=1.0.0
# Comma separated. First entry is the browser origin used in local dev.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# IANA timezone used to interpret admin date filters (calendar dates).
# Requires the `tzdata` package on Windows; a fixed IST offset is the fallback.
DISPLAY_TIMEZONE=Asia/Kolkata

# --- database --------------------------------------------------------------
# Local docker-compose Postgres (see repo root docker-compose.yml):
DATABASE_URL=postgresql+asyncpg://bookleaf:bookleaf@localhost:5432/bookleaf
# Zero-setup local alternative (also used by the automated tests):
# DATABASE_URL=sqlite+aiosqlite:///./bookleaf.db
DATABASE_ECHO=false
# Dev convenience only: create tables on boot instead of `alembic upgrade head`.
AUTO_CREATE_TABLES=true

# --- auth ------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-in-production-4f8a2c9e1b7d
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- seeded demo accounts --------------------------------------------------
SEED_DEFAULT_PASSWORD=password123
ADMIN_ID=ADMIN001
ADMIN_NAME=Aarav Mehta
ADMIN_EMAIL=admin@bookleaf.com
ADMIN_PASSWORD=password123

# ===========================================================================
#  AI / SLM CONFIGURATION
#  The provider factory speaks the OpenAI Chat Completions protocol, so the
#  only thing that changes between OpenAI, Groq, Together and Ollama is the
#  base URL + model name. No application code changes required.
# ===========================================================================

# Active provider: mock | openai | anthropic | slm_cloud | slm_local
AI_PROVIDER=mock

# --- PRESET 1: OpenAI (commercial cloud LLM - default for reliability) ------
# AI_PROVIDER=openai
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini

# --- PRESET 2: Anthropic (commercial cloud LLM) -----------------------------
# AI_PROVIDER=anthropic
# AI_API_KEY=sk-ant-...
# AI_MODEL=claude-3-5-haiku-latest
# AI_BASE_URL is not used for Anthropic (native SDK).

# --- PRESET 3: Groq / Together (high-speed cloud SLM) ----------------------
# AI_PROVIDER=slm_cloud
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=gsk_...
# AI_MODEL=llama-3.1-8b-instant
# Together AI alternative:
# AI_BASE_URL=https://api.together.xyz/v1
# AI_MODEL=Qwen/Qwen2.5-7B-Instruct-Turbo

# --- PRESET 4: Local Ollama / vLLM (self-hosted SLM, zero API cost) --------
# AI_PROVIDER=slm_local
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=ollama
# AI_MODEL=llama3.2:3b
# Other good options: phi3:mini, qwen2.5:7b

# --- provider tuning -------------------------------------------------------
# `mock` needs no key and runs a deterministic BookLeaf rule engine, so the
# demo works offline. If a real provider is selected without a key, the app
# logs a warning and uses the same rule engine instead of failing requests.
AI_TIMEOUT_SECONDS=8
AI_MAX_RETRIES=1
AI_TOTAL_TIMEOUT_SECONDS=20
AI_TEMPERATURE=0.2
AI_MAX_OUTPUT_TOKENS=700
# When true, classification and drafting happen in two cheaper passes
# (triage first, then a category-scoped draft prompt). When false, one
# compact call does both. Two-pass costs an extra round trip but sends a
# ~250 token KB slice to the drafting call.
AI_TWO_PASS=false

# --- optional dual-engine fallback (used on 429/5xx/timeout) ---------------
# Leave empty to disable. Example: fall back from Groq cloud to local Ollama.
AI_FALLBACK_PROVIDER=
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
